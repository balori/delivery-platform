<mxfile host="app.diagrams.net" type="device">
  <diagram name="delivery-platform" id="delivery-platform-arch">
    <mxGraphModel dx="1000" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="delivery-platform — tag-triggered release" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="460" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tag" value="git tag vX.Y.Z" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="build" value="GitHub Actions&#10;docker build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="210" y="85" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ghcr" value="GHCR&#10;image:semver + :sha" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="390" y="80" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="gate" value="Environment&#10;approval" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="570" y="80" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="apply" value="kubectl apply -k&#10;overlays/production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="80" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="k8s" value="Kubernetes cluster" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#9673a6;dashed=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="210" width="400" height="220" as="geometry" />
        </mxCell>

        <mxCell id="deploy" value="Deployment&#10;deploy-tracker-api&#10;(rolling update)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="250" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="hpa" value="HPA&#10;2..12 replicas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="250" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="svc" value="Service + Ingress&#10;/health probes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="350" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c1" style="html=1;endArrow=block;rounded=1;" edge="1" parent="1" source="tag" target="build"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" value="push" style="html=1;endArrow=block;rounded=1;" edge="1" parent="1" source="build" target="ghcr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="html=1;endArrow=block;rounded=1;" edge="1" parent="1" source="ghcr" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" value="approved" style="html=1;endArrow=block;rounded=1;" edge="1" parent="1" source="gate" target="apply"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" style="html=1;endArrow=block;rounded=1;" edge="1" parent="1" source="apply" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" value="scales" style="html=1;endArrow=open;dashed=1;rounded=1;" edge="1" parent="1" source="hpa" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c7" style="html=1;endArrow=block;rounded=1;" edge="1" parent="1" source="deploy" target="svc"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
